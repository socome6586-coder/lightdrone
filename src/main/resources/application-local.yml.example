# =====================================================================
# application-local.yml.example  (로컬 개발용 비밀값 템플릿)
#
# 사용법:
#   1) 이 파일을 같은 폴더에 application-local.yml 로 복사한다.
#        cp application-local.yml.example application-local.yml
#   2) 아래 값을 본인 로컬/테스트 키로 채운다.
#   3) `local` 프로파일로 실행한다.
#        ./gradlew bootRun --args="--spring.profiles.active=local"
#
# 주의:
#   - application-local.yml 은 .gitignore 대상이라 커밋되지 않는다(실제 키 보관용).
#   - 이 .example 파일에는 절대 실제 키를 넣지 말 것(저장소에 추적됨).
#   - 비밀값을 파일 대신 환경변수로 주입해도 된다(아래 docs 참고).
#   - 운영(prod) 에는 이 파일을 쓰지 않는다. bootJar 빌드에서 제외되며,
#     운영 비밀값은 배포 환경의 환경변수로만 주입한다.
#
# 환경변수로 주입할 경우(파일 없이) 필요한 키 목록:
#   DB_PASSWORD            (필수: 미설정 시 부팅 실패)
#   SMS_API_KEY / SMS_API_SECRET / SMS_SENDER
#   ADMIN_PHONES
#   TOSS_CLIENT_KEY / TOSS_SECRET_KEY
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#   KAKAO_CLIENT_ID / KAKAO_CLIENT_SECRET
#   BREVO_API_KEY / MAIL_SENDER_EMAIL
# =====================================================================

spring:
  datasource:
    # 로컬 PostgreSQL(docker: lightdrone-pg) 기본값 그대로 쓰려면 url/username 생략 가능.
    # 비밀번호는 반드시 채울 것(application.yml 에 기본값이 없음).
    url: jdbc:postgresql://localhost:5432/lightdrone
    username: lightdrone
    password: CHANGE_ME_LOCAL_DB_PASSWORD
    driver-class-name: org.postgresql.Driver

# Coolsms (문자 발송) — 미사용 시 비워두면 발송만 비활성화됨
sms:
  api-key: ""
  api-secret: ""
  sender: ""

# 관리자 알림 수신 번호 (쉼표 구분)
admin:
  phones: ""

# 토스페이먼츠 — 로컬은 토스 "테스트키"(test_ck_/test_sk_) 사용
toss:
  payments:
    client-key: ""
    secret-key: ""

# 소셜 로그인 — 사용할 때만 채우기(미사용 시 비워두면 로그인만 비활성)
spring.security.oauth2.client.registration:
  google:
    client-id: ""
    client-secret: ""
  kakao:
    client-id: ""
    client-secret: ""

# 메일(Brevo) — 미사용 시 비워두기
brevo:
  api-key: ""
  sender-email: ""
