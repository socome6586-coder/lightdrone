.gradle/
build/
*.class
*.jar
!gradle-wrapper.jar
*.exe

# IDE
.classpath
.project
.settings/
bin/
.idea/
*.iml

# 민감 정보
# application.yml 은 시크릿을 모두 환경변수(${ENV})로 외부화했으므로 추적 허용.
#   (실제 비밀값은 환경변수 또는 application-local.yml 로만 주입)
src/main/resources/application-*.yml
# 운영 프로파일은 시크릿 없는 오버라이드(로깅·캐시 등)만 담으므로 추적 허용
!src/main/resources/application-prod.yml
# 로컬 비밀값 설정 예시 템플릿(실제 키 없음)은 추적 허용
!src/main/resources/application-local.yml.example

# Claude 세션 데이터
.claude/

# Eclipse 빌드 설정 (경로 하드코딩으로 타 PC에서 미사용)
.externalToolBuilders/

# Windows 바로가기
*.lnk

# Eclipse 자동 생성 webapp (Spring Boot Thymeleaf 프로젝트에서 미사용)
src/main/webapp/

# 업로드된 파일 (서버에서 생성, 저장소에 불필요)
uploads/

# 로그 파일
*.log
run_log.txt
run_out.txt
run_err.txt

# 로컬 실행 로그·작업 산출물 (저장소에 불필요)
run/
_img_backup/

# 개인 포트폴리오 문서 (프로젝트 코드와 무관)
PORTFOLIO_LIGHTDRONE.md

# 터널링 실행 파일 (*.exe 로도 걸리지만 명시)
cloudflared.exe
ngrok.exe
